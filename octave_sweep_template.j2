
%---------------------------------------------------------------------------------------------------------------------------
%% Clear Console
%---------------------------------------------------------------------------------------------------------------------------
plecs('clc');                                           % Clear Console.
plecs('warning', 'warning message');                    % Display Warnings.

%---------------------------------------------------------------------------------------------------------------------------
%% Model variables : evaluated from the model's own Initialization Commands
%---------------------------------------------------------------------------------------------------------------------------
% Makes every model variable available in this workspace, so the script only has to carry the swept parameters.
% Done first, so the script's own variables below always take precedence over model variables with the same name.
initCmds = plecs('get', plecs('get', '', 'CurrentCircuit'), 'InitializationCommands');
eval(initCmds);

%---------------------------------------------------------------------------------------------------------------------------
%% Configuration
%---------------------------------------------------------------------------------------------------------------------------
% All result paths are relative to BASE_DIR, the folder of this model file: PLECS makes that folder the current folder
% (pwd) when the model runs. So the model can be copied to any PC or folder and the results are written next to it.
% To write the results somewhere else, set BASE_DIR to that folder instead, e.g. BASE_DIR = 'C:/Results';
BASE_DIR        = pwd;                                  % Folder of this model file
RESULTS_DIR     = fullfile(BASE_DIR, '{{ scopes_folder }}');    % Directory for scopes traces
CSV_DIR         = fullfile(BASE_DIR, '{{ csv_folder }}');       % Directory for csv time series results
CSV_PREFIX      = fullfile(BASE_DIR, '{{ FileNameStandalonePath }}');   % Start of each iteration's csv file name (ToFile block)
HOLD_TRACES     = true;                                 % Set to true to hold traces after each simulation
CLEAR_TRACES    = true;                                 % Set to true to clear traces before starting
SAVE_TRACES     = true;                                 % Set to true to save traces to files
PARALLEL        = {{ 'true' if parallel else 'false' }};                                % true : all iterations run at once in parallel (PLECS 4.6+), false : one after another

%---------------------------------------------------------------------------------------------------------------------------
%% Sweep data
%---------------------------------------------------------------------------------------------------------------------------
{% if mapvars_dim == 3 %}
data = {
    {% for row in mapvars %}
    { {% for inner in row %}[{{ inner | join(', ') }}]{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %};
    {% endif %}
    {% endfor %}
};
{% else %}
data = [
    {% for row in mapvars %}    [{{ row | join(', ') }}];
    {% endfor %}
];
{% endif %}

%---------------------------------------------------------------------------------------------------------------------------
%% Simulation struct : only the top-level model variables the sweep changes
%---------------------------------------------------------------------------------------------------------------------------
% Their current values come from the Initialization Commands evaluated above; all other model variables keep the values
% the model's own Initialization Commands give them when the simulation starts.
simStruct = struct('ModelVars', struct(), 'SolverOpts', {{ solveropts_struct }});
{% for name in modelvars_top %}
simStruct.ModelVars.{{ name }} = {{ name }};
{% endfor %}

%---------------------------------------------------------------------------------------------------------------------------
%% Model
%---------------------------------------------------------------------------------------------------------------------------

mdl         = plecs('get', '', 'CurrentCircuit');               % Get model name and scope list
mdl_name    = (strsplit(mdl, filesep)){end};                    % Extract just the model name
mdl_name    = (strsplit(mdl_name, '.')){1};                     % Remove extension
scopes      = { {{ scopes | map('tojson') | join(', ') }} };    % List of scopes in the model%
t           = localtime(time());

%---------------------------------------------------------------------------------------------------------------------------
%% Clear Scopes
%---------------------------------------------------------------------------------------------------------------------------

% Clear all traces before starting if enabled
if CLEAR_TRACES
    for i = 1:length(scopes)
        try
            plecs('scope', [mdl '/' scopes{i}], 'ClearTraces');
        catch
            % Silently ignore errors
        end
    end
end

% Create the result folders (with any missing parent folders). The csv folder is always needed, because the ToFile
% block writes there in every iteration; the scope traces folder only when the traces are saved.
if ~exist(CSV_DIR, 'dir')
    mkdir(CSV_DIR);
end
if SAVE_TRACES && ~exist(RESULTS_DIR, 'dir')
    mkdir(RESULTS_DIR);
end

%---------------------------------------------------------------------------------------------------------------------------
%% Header
%---------------------------------------------------------------------------------------------------------------------------
disp(sprintf('%s', '-' * ones(1, 90)));
disp(sprintf('%s', '-' * ones(1, 90)));
disp(sprintf('SIMULATION STARTED'));
disp(sprintf('%s', '-' * ones(1, 90)));
disp(sprintf('%s', '-' * ones(1, 90)));

disp(sprintf('Date               : %s', strftime("%r(%Z) %A %e %B %Y", t)));
disp(sprintf('Time               : %s', strftime("%H:%M:%S", t)));
disp(sprintf('Model              : %s', mdl_name));
disp(sprintf('Results folder     : %s', BASE_DIR));
disp(sprintf('Iterations         : %d', size(data, 1)));
if PARALLEL
    disp(sprintf('Execution          : parallel'));
else
    disp(sprintf('Execution          : sequential'));
end

%---------------------------------------------------------------------------------------------------------------------------
%% Main Loop
%---------------------------------------------------------------------------------------------------------------------------

% Parallel : the loop only prepares one simulation struct per iteration; they all run together after the loop.
% Every iteration starts again from the untouched baseStruct, so values set by one iteration never carry over to the next.
if PARALLEL
    simStructs  = cell(1, size(data, 1));
    baseStruct  = simStruct;
end

for sim = 1:size(data, 1)

    if PARALLEL
        simStruct = baseStruct;
    end

    %% ------------------------------------------------------------------------
    disp(sprintf('%s', '-' * ones(1, 90)));
    disp(sprintf('Iteration Number   : %d', sim));
    %% ------------------------------------------------------------------------

    {% for i, expr in mappings.items() %}
    % Assign value
    {{ expr }};

    % Print evaluated value
    disp(sprintf('%-50s = %12g','{{ expr.split("=")[0].strip() }}', {{ expr.split("=")[0].strip() }}));
    {% endfor %}

    % Construct filename using strcat with simulation number
    filename    = strcat(CSV_PREFIX, sprintf('%01d_Standalone.csv', sim));

    % Assign filename to ToFile block
    simStruct.ModelVars.Common.ToFile.FileNameStandalone = filename;

    % Print filename for verification
    disp(sprintf('Output File: %s', filename));

    % Parallel : store this iteration's struct (named like the held traces) and go on to the next one
    if PARALLEL
        simStruct.Name      = sprintf('Iter_%d_Standalone', sim);
        simStructs{sim}     = simStruct;
        continue;
    end

    %% ------------------------------------------------------------------------
    plecs('simulate', simStruct);
    %% ------------------------------------------------------------------------

    %% Hold traces for all scopes if enabled
    if HOLD_TRACES
        trace_name = sprintf('Iter_%d_Standalone', sim);
        for i = 1:length(scopes)
            try
                plecs('scope', [mdl '/' scopes{i}], 'HoldTrace', trace_name);
            catch
                % Silently ignore errors
            end
        end
    end
    %% ------------------------------------------------------------------------
end

%---------------------------------------------------------------------------------------------------------------------------
%% Parallel run : all prepared iterations at once
%---------------------------------------------------------------------------------------------------------------------------
if PARALLEL
    disp(sprintf('%s', '-' * ones(1, 90)));
    disp(sprintf('Running %d simulations in parallel ...', numel(simStructs)));

    % Callback PLECS calls after each parallel simulation finishes. It is an anonymous function on purpose: a named
    % function in this script makes the script's workspace static, and eval(initCmds) above then fails with
    % "can not add variable ... to a static workspace".
    % It holds this iteration's traces under the same name the sequential loop uses (errors ignored), and keeps only a
    % small status instead of the full result: true on success, PLECS's error message if the run failed, so a large
    % sweep does not keep every simulation's waveforms in memory (the data itself is already written by the ToFile block).
    hold_traces     = @(index) cellfun(@(s) plecs('scope', [mdl '/' s], 'HoldTrace', sprintf('Iter_%d_Standalone', index)), ...
                                       scopes, 'UniformOutput', false, 'ErrorHandler', @(varargin) []);
    sweep_callback  = @(index, result) {HOLD_TRACES && iscell(hold_traces(index)), true, result}{2 + ~isstruct(result)};

    out = plecs('simulate', simStructs, sweep_callback);

    % Report the iterations that failed (their cell holds the error message instead of true)
    n_failed = 0;
    for k = 1:numel(out)
        if ischar(out{k})
            n_failed = n_failed + 1;
            disp(sprintf('Iteration %d FAILED : %s', k, out{k}));
        end
    end
    disp(sprintf('Failed iterations  : %d of %d', n_failed, numel(out)));
end

%---------------------------------------------------------------------------------------------------------------------------
%% Save traces once per scope after all iterations
%---------------------------------------------------------------------------------------------------------------------------
if SAVE_TRACES
    for i = 1:length(scopes)
        try
            scope_path = [mdl '/' scopes{i}];
            % Replace any slashes in scope name for filename
            safe_scope_name = strrep(scopes{i}, '/', '_');
            safe_scope_name = [safe_scope_name '_Standalone'];
            trace_file = fullfile(RESULTS_DIR, sprintf('%s', safe_scope_name));
            plecs('scope', scope_path, 'SaveTraces', trace_file);
        catch
            % Silently ignore errors
        end
    end
end
%---------------------------------------------------------------------------------------------------------------------------
%% Footer
%---------------------------------------------------------------------------------------------------------------------------
disp(sprintf('%s', '-' * ones(1, 90)));
disp(sprintf('%s', '-' * ones(1, 90)));
disp(sprintf('SIMULATION FINISHED : Ran %d Iterations', size(data, 1)));
disp(sprintf('%s', '-' * ones(1, 90)));
disp(sprintf('%s', '-' * ones(1, 90)));
%---------------------------------------------------------------------------------------------------------------------------