            Value         "1/OBC_param.Control.fs"
            Show          off
          }
          Parameter {
            Variable      "TerminalBasedSampleTimes"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Parameters"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "LangStandard"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "GnuExtensions"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "RuntimeCheck"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "HighlightLevel"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "Declarations"
            Value         "#include <math.h>\n"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "/* Sector & duty, sampled once per switching period"
" (at the carrier reset).\n"
" * Inputs : Sa, Sb, Sc = (va > 0), (vb > 0), (vc > 0)   -- comparator outputs"
", they rise / fall at the voltage zero crossings\n"
" *          va, vb, vc\n"
" * Outputs: k  = main phase (1 = a, 2 = b, 3 = c): the phase whose sign diffe"
"rs from the other two\n"
" *               (= the phase with the largest |v|, it carries the sum of the"
" other two currents)\n"
" *          s  = sign of the main phase (+1 / -1)\n"
" *          dm = |v_m| / |v_k| with m = the phase after k (a->b->c->a); the t"
"hird phase n gets 1 - dm\n"
" * The sector changes exactly when one of Sa, Sb, Sc toggles, i.e. every 60 d"
"egrees of the grid voltage.\n"
" */\n"
"int Sa = Input(0) > 0.5, Sb = Input(1) > 0.5, Sc = Input(2) > 0.5;\n"
"double v[3] = { Input(3), Input(4), Input(5) };\n"
"int k, m;\n"
"double vk, vm;\n"
"\n"
"if (Sa + Sb + Sc == 1)          /* one positive phase: it is the main phase, "
"s = +1 */\n"
"{\n"
"    k = Sa ? 0 : (Sb ? 1 : 2);\n"
"    Output(1) = 1;\n"
"}\n"
"else if (Sa + Sb + Sc == 2)     /* one negative phase: it is the main phase, "
"s = -1 */\n"
"{\n"
"    k = !Sa ? 0 : (!Sb ? 1 : 2);\n"
"    Output(1) = -1;\n"
"}\n"
"else                            /* all signs equal: only at the exact start ("
"all zero) -> largest |v| */\n"
"{\n"
"    k = 0;\n"
"    if (fabs(v[1]) > fabs(v[k])) k = 1;\n"
"    if (fabs(v[2]) > fabs(v[k])) k = 2;\n"
"    Output(1) = v[k] >= 0 ? 1 : -1;\n"
"}\n"
"m  = (k + 1) % 3;\n"
"vk = fabs(v[k]);\n"
"vm = fabs(v[m]);\n"
"Output(0) = k + 1;\n"
"Output(2) = vk > 1e-6 ? (vm / vk > 1.0 ? 1.0 : vm / vk) : 0.5;\n"
            Show          off
          }
          Parameter {
            Variable      "UpdateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "DerivativeFcn"
            Value         ""
            Show          off
          }
