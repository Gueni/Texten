  InitializationCommands "\n\n\nCommon.simParams.tSim \t\t\t= 1;\nCommon.simPa"
"rams.Maxstep \t\t= 1e-07;\nCommon.simParams.Fixedstep \t= 1e-08;\nCommon.simP"
"arams.RelTol \t\t= 0.0001;\nCommon.simParams.ZeroCross \t= 1000;\nCommon.simP"
"arams.Refine \t\t= 1;\n\nOBC_param.Grid.Vrms \t\t\t\t= 230.0;\nOBC_param.Grid"
".f \t\t\t\t\t= 50.0;\n\nOBC_param.Filter.Lf \t\t\t\t= 0.0001;\nOBC_param.Filt"
"er.Rd \t\t\t\t= 5.0;\nOBC_param.Filter.Cf \t\t\t\t= 1e-05;\n\nOBC_param.Contr"
"ol.fs \t\t\t= 100000.0;\nOBC_param.Control.phi \t\t\t= 0.1;\n\nOBC_param.Matr"
"ix.Ron \t\t\t= 0.0;\nOBC_param.Secondary.Ron \t\t= 0.0;\nOBC_param.Lr.L \t\t"
"\t\t\t= 1.9e-05;\n\nOBC_param.Trafo.Np \t\t\t\t= 27;\nOBC_param.Trafo.Ns \t\t"
"\t\t= 11;\nOBC_param.Trafo.Lm \t\t\t\t= 0.002;\n\n\nOBC_param.Co.C \t\t\t\t\t"
"= 0.0002;\nOBC_param.Co.Vinit \t\t\t\t= 0;\n\nOBC_param.Load.R \t\t\t\t\t= 14"
".5;\n"
